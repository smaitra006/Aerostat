# AeroStat Environment Variables

# PostgreSQL Database Connection String
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://aerostat_user:aerostat_password@localhost:5432/aerostat_db

# Application Configuration
PROJECT_NAME="AeroStat"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
